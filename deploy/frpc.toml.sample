# deploy/frpc.toml.sample — frp 客户端配置样例
#
# 用途: 把本机边缘代理(deploy/edge-proxy.mjs)经 frp 隧道挂到一台有公网
# 入口的 frps 网关上, 按域名 + 路径对外提供服务。
# 使用: 复制为 frpc.toml, 把所有 <占位符> 换成你自己的值后再启动:
#   frpc -c frpc.toml
# ⚠️ <FRP_TOKEN> 等敏感值只应存在于你部署机上的这份副本里, 不要提交回仓库。

serverAddr = "<FRPS_SERVER_IP_OR_DOMAIN>"
serverPort = 7000
auth.token = "<FRP_TOKEN>"
transport.tls.enable = true

[[proxies]]
name = "mes-web"
type = "http"
localIP = "127.0.0.1"
localPort = 18090
customDomains = ["<YOUR_DOMAIN>"]
locations = ["/mes"]
