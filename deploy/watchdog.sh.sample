#!/bin/bash
# deploy/watchdog.sh.sample — 极简看门狗样例(无 systemd 的容器/裸机环境用)
#
# 每 30 秒检查 pocketbase / edge-proxy / frpc 三个进程, 缺谁拉谁。
# PID 文件 + /proc/<pid>/cmdline 双重校验, 避免 PID 复用误判。
# 使用: 复制为 watchdog.sh, 按你的实际路径改下面 4 个变量, 然后
#   nohup bash watchdog.sh >/var/log/mes-watchdog.log 2>&1 &
#
# 环境变量(也可直接改默认值):
#   MES_HOME       部署根目录(含 pocketbase 二进制与 pb_data/pb_hooks/pb_public)
#   MES_NODE       node 二进制路径
#   APP_PREFIX     子路径前缀(与构建时的 --base 一致, 如 /mes; 根路径填 /)
#   FRPC_CONFIG    frpc 配置路径(不需要 frp 时设为空字符串)

MES_HOME="${MES_HOME:-/opt/mes}"
MES_NODE="${MES_NODE:-node}"
APP_PREFIX="${APP_PREFIX:-/mes}"
FRPC_CONFIG="${FRPC_CONFIG:-$MES_HOME/frpc.toml}"
PB_HTTP="${PB_HTTP:-127.0.0.1:8090}"
PROXY_PORT="${PROXY_PORT:-18090}"
RUN_DIR="$MES_HOME/run"
mkdir -p "$RUN_DIR"

alive() { # $1=pidfile $2=cmdline 关键字
  local pidfile="$1" kw="$2" pid
  [ -f "$pidfile" ] || return 1
  pid=$(cat "$pidfile" 2>/dev/null) || return 1
  [ -n "$pid" ] && [ -d "/proc/$pid" ] || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "$kw"
}

while true; do
  if ! alive "$RUN_DIR/pb.pid" "pocketbase"; then
    (cd "$MES_HOME" && nohup ./pocketbase serve --http "$PB_HTTP" \
      --dir "$MES_HOME/pb_data" --hooksDir "$MES_HOME/pb_hooks" \
      --publicDir "$MES_HOME/pb_public" >> "$MES_HOME/pb.log" 2>&1 &
     echo $! > "$RUN_DIR/pb.pid")
    echo "[watchdog] $(date '+%F %T') restarted pocketbase"
  fi

  if ! alive "$RUN_DIR/proxy.pid" "edge-proxy"; then
    (cd "$MES_HOME" && APP_PREFIX="$APP_PREFIX" PORT="$PROXY_PORT" PB_TARGET="http://$PB_HTTP" \
      nohup "$MES_NODE" deploy/edge-proxy.mjs >> "$MES_HOME/proxy.log" 2>&1 &
     echo $! > "$RUN_DIR/proxy.pid")
    echo "[watchdog] $(date '+%F %T') restarted edge-proxy"
  fi

  if [ -n "$FRPC_CONFIG" ] && [ -f "$FRPC_CONFIG" ] && ! alive "$RUN_DIR/frpc.pid" "frpc"; then
    (cd "$MES_HOME" && nohup ./frpc -c "$FRPC_CONFIG" >> "$MES_HOME/frpc.log" 2>&1 &
     echo $! > "$RUN_DIR/frpc.pid")
    echo "[watchdog] $(date '+%F %T') restarted frpc"
  fi

  sleep 30
done
