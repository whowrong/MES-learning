+  moduleId: "delivery",
+  moduleName: "上线陪产 · 交付闭环",
+  subtitle: "",
+  intro: "",
+  knowledge_ids: ["K9-8"],
+  cards: [{ id: "c1", title: "卡片", summary: "", points: ["要点"], pitfalls: ["坑"], term_ids: [], knowledge_ids: ["K9-8"] }],
+  questions: [q({}), q({ id: "q2", answer: "b" }), q({ id: "q3", type: "multiple", answer: ["a", "b"] })],
