+    const r = checkDeliverable(deliverable, "")
+    expect(r.chars).toBe(0)
+    expect(r.enough).toBe(false)
+    expect(r.passed).toBe(0)
+    expect(r.complete).toBe(false)
+    expect(r.missing).toEqual(["版本号与生效日期", "角色与适用范围", "截图占位"])
