new file mode 100644
index 0000000..d2326d5
--- /dev/null
+++ b/src/game/labScripts.ts
@@ -0,0 +1,274 @@
+// 实操营「AI 生成环境脚本」的纯逻辑：提示词拼装、模型输出解析、危险判定与步骤断言。
+//
+// 约束：
+// - 只读题目文档与连接描述（主机/端口/库名/账号），绝不把口令或密钥写进提示词；
+// - 模型必须返回结构化 JSON，解析失败要明确报错，不静默通过；
+// - 步骤是否达标由 accept 正则判定，不采信模型自述的「已完成」；
+// - 危险命令沿用站内既有拦截清单（GLOBAL_DANGER），不另起一套标准。
+import { GLOBAL_DANGER } from "./opsTerminal"
+
+/** 站内 AI 用的上游模型（与站内其它 AI 功能同一个通道） */
+export const LAB_LLM_MODEL = "mimo-v2.6-pro"
+
+/** 一次演练连接的描述：只含非敏感信息 */
+export interface LabConnection {
+  kind: "db" | "server"
+  /** 数据库类型：mysql / postgres / sqlserver */
+  type?: string
+  host?: string
+  port?: string | number
+  database?: string
+  username?: string
+}
+
+export interface LabStep {
+  id: string
+  title: string
+  command: string
+  /** 预期现象（人看） */
+  expect: string
+  /** 命中即通过的正则（沿用站内 accept 口径，机器判定） */
+  assert: string[]
+  danger?: boolean
+  dangerNote?: string
+}
+
+export interface LabScript {
+  env_check: string[]
+  prep_steps: LabStep[]
+  exec_steps: LabStep[]
+  notes: string
+}
+
+export interface LabParseOk {
+  ok: true
+  script: LabScript
+}
+
+export interface LabParseFail {
+  ok: false
+  error: string
+}
+
+/** 拼装给模型的提示词：文档 + 连接描述 + 输出格式约束 */
+export function buildLabScriptPrompt(opts: {
+  title: string
+  doc: string
+  connection: LabConnection
+}): string {
+  const { title, doc, connection } = opts
+  const connLines =
+    connection.kind === "db"
+      ? [
+          `数据库类型：${connection.type || "未指定"}`,
+          `主机：${connection.host || "未指定"}`,
+          `端口：${connection.port || "默认"}`,
+          `库名：${connection.database || "未指定"}`,
+          `账号：${connection.username || "未指定"}`,
+          "（口令不会、也不需要写进脚本：由用户在本地执行时自行提供）",
+        ]
+      : [
+          `主机：${connection.host || "未指定"}`,
+          `端口：${connection.port || "默认"}`,
+          `账号：${connection.username || "未指定"}`,
+          "（SSH 口令/私钥不会、也不需要写进脚本）",
+        ]
+  const kindWord = connection.kind === "db" ? "数据库" : "服务器"
+  const kindRules =
+    connection.kind === "db"
+      ? [
+          "6. 数据库题的 command 必须是**纯 SQL 语句**（一条一步，可直接交给数据库执行）：",
+          "   不要写 mysql/psql 命令行，不要写 shell 管道，不要把 SQL 包在引号或 -e 参数里。",
+          "7. 查询类题目只做只读查询：除非文档明确要求，不要 INSERT/UPDATE/DELETE/DROP/TRUNCATE 题目涉及的表。",
+          "8. 需要多条 SQL 时按依赖顺序拆成多步，前一步的结果要在下一步里用得上。",
+        ]
+      : [
+          "6. 服务器题的 command 必须是**单条 shell 命令**（可直接在 SSH 上执行），不要写交互式脚本块或多行 heredoc。",
+          "7. 不要把口令、密钥、token 写进命令；需要凭据时用占位符并提示用户自行提供。",
+        ]
+  return [
+    "你是 MES 实操营的演练环境助手。请依据下面这份题目文档，为用户在**演练专用**环境上生成可执行的环境准备脚本与执行脚本。",
+    "",
+    `## 题目`,
+    title,
+    "",
+    `## 用户提供的${kindWord}连接`,
+    ...connLines,
+    "",
+    "## 题目文档",
+    doc,
+    "",
+    "## 输出要求",
+    "只输出一个 JSON 对象，不要输出解释文字、不要用 Markdown 代码块包裹。结构如下：",
+    JSON.stringify(
+      {
+        env_check: ["准备前要确认的只读检查（如确认版本/监听/连通性）"],
+        prep_steps: [
+          {
+            id: "p1",
+            title: "这一步做什么",
+            command: "可直接执行的命令或 SQL",
+            expect: "预期看到的现象",
+            assert: ["命中即通过的正则，至少一条"],
+            danger: false,
+            dangerNote: "若该命令有破坏性，说明后果",
+          },
+        ],
+        exec_steps: [
+          {
+            id: "e1",
+            title: "正式执行的一步",
+            command: "命令或 SQL",
+            expect: "预期现象",
+            assert: ["正则"],
+            danger: false,
+            dangerNote: "",
+          },
+        ],
+        notes: "整体提醒（必读：这是演练环境，破坏性操作的后果是什么）",
+      },
+      null,
+      1,
+    ),
+    "硬性约束：",
+    "1. 每条命令都要能在上面的连接描述里落地；不要臆造不存在的路径、服务名或表名。",
+    "2. 每一步都必须给出 assert 正则；没有正则的步骤视为不合格。",
+    "3. 脚本里不得出现口令、密钥、token 等敏感信息；需要凭据时写成占位符并让用户自行提供。",
+    "4. 删除、重建、清库、杀进程、改防火墙、重启服务等操作必须标 danger=true，并在 dangerNote 里写清后果。",
+    "5. 顺序必须是：先只读检查（env_check），再准备（prep_steps），最后正式执行（exec_steps）。",
+    ...kindRules,
+  ].join("\n")
+}
+
+/** 从模型输出里抠出 JSON（容忍 ```json 包裹与前后废话） */
+export function extractJsonBlock(text: string): string | null {
+  const trimmed = (text ?? "").trim()
+  if (!trimmed) return null
+  const fence = trimmed.match(/```(?:json)?\s*([\s\S]*?)```/i)
+  const body = fence ? fence[1] : trimmed
+  const start = body.indexOf("{")
+  const end = body.lastIndexOf("}")
+  if (start === -1 || end === -1 || end <= start) return null
+  return body.slice(start, end + 1)
+}
+
+function toSteps(raw: unknown): LabStep[] {
+  if (!Array.isArray(raw)) return []
+  return raw
+    .map((item, idx) => {
+      const o = (item ?? {}) as Record<string, unknown>
+      const command = String(o.command ?? "").trim()
+      const assertRaw = Array.isArray(o.assert) ? o.assert : []
+      const assert = assertRaw.map((a) => String(a)).filter((a) => a.length > 0)
+      return {
+        id: String(o.id ?? `s${idx + 1}`),
+        title: String(o.title ?? `步骤 ${idx + 1}`),
+        command,
+        expect: String(o.expect ?? ""),
+        assert,
+        danger: Boolean(o.danger),
+        dangerNote: String(o.dangerNote ?? ""),
+      } satisfies LabStep
+    })
+    .filter((s) => s.command.length > 0)
+}
+
+/** 解析模型输出：结构不合法就明确报错，不静默通过 */
+export function parseLabScriptResponse(text: string): LabParseOk | LabParseFail {
+  const json = extractJsonBlock(text)
+  if (!json) {
+    return { ok: false, error: "AI 返回的内容里找不到 JSON 脚本（可能被截断或夹带了解释文字），请重新生成或改用手工执行。" }
+  }
+  let obj: unknown
+  try {
+    obj = JSON.parse(json)
+  } catch {
+    return { ok: false, error: "AI 返回的 JSON 解析失败，脚本不可用，请重新生成或改用手工执行。" }
+  }
+  if (!obj || typeof obj !== "object") {
+    return { ok: false, error: "AI 返回的结构不是对象，脚本不可用。" }
+  }
+  const o = obj as Record<string, unknown>
+  const prep = toSteps(o.prep_steps)
+  const exec = toSteps(o.exec_steps)
+  if (prep.length === 0 && exec.length === 0) {
+    return { ok: false, error: "AI 没有给出任何可执行步骤（prep_steps / exec_steps 都是空的）。" }
+  }
+  const noAssert = [...prep, ...exec].filter((s) => s.assert.length === 0)
+  if (noAssert.length > 0) {
+    return {
+      ok: false,
+      error: `AI 生成的 ${noAssert.length} 个步骤缺少验收正则（assert），无法机器判定，已丢弃本次结果。`,
+    }
+  }
+  const envCheck = Array.isArray(o.env_check) ? o.env_check.map((x) => String(x)).filter((x) => x.length > 0) : []
+  return {
+    ok: true,
+    script: {
+      env_check: envCheck,
+      prep_steps: prep,
+      exec_steps: exec,
+      notes: String(o.notes ?? ""),
+    },
+  }
+}
+
+/** 危险命令判定：沿用站内既有拦截清单 */
+export function detectLabDanger(command: string): { danger: boolean; note: string } {
+  const cmd = (command ?? "").trim()
+  for (const rule of GLOBAL_DANGER) {
+    try {
+      if (new RegExp(rule.pattern).test(cmd)) {
+        return { danger: true, note: rule.output }
+      }
+    } catch {
+      // 正则本身坏了就跳过，不影响其它规则
+    }
+  }
+  const destructive =
+    /\b(rm\s+-rf|mkfs|dd\s+if=|:\(\)\{|shutdown|reboot|kill\s+-9|drop\s+(database|table)|truncate\s+table|delete\s+from|chmod\s+-R\s+777|iptables\b|firewall-cmd\b|systemctl\s+(stop|restart|disable))\b/i
+  if (destructive.test(cmd)) {
+    return {
+      danger: true,
+      note: "⚠️ 该命令可能造成不可逆破坏（删除/重建/清空/重启）。请确认目标确实是演练专用环境后再执行。",
+    }
+  }
+  return { danger: false, note: "" }
+}
+
+/** 步骤断言：命中任一 accept 正即算通过 */
+export function matchLabAssert(step: LabStep, output: string): boolean {
+  const text = output ?? ""
+  return step.assert.some((pattern) => {
+    try {
+      return new RegExp(pattern, "m").test(text)
+    } catch {
+      return false
+    }
+  })
+}
+
+/** 生产环境迹象：主机名里带 prod / 生产 / 正式 / production */
+export function looksLikeProduction(host: string): boolean {
+  const h = (host ?? "").trim().toLowerCase()
+  if (!h) return false
+  return /(^|[^a-z])(prod|production)([^a-z]|$)/.test(h) || /生产|正式|线上/.test(h)
+}
+
+/**
+ * 环境不符检测：题目文档点名要某个数据库引擎，而用户连的是另一种引擎时提前提示。
+ * 只在文档明确点名引擎时判断，避免误报。
+ */
+export function environmentMismatch(doc: string, connection: LabConnection): string | null {
+  if (connection.kind !== "db" || !connection.type) return null
+  const text = (doc ?? "").toLowerCase()
+  const wantsMysql = /mysql\s*8|mysql\s*\d/.test(text) && !/postgresql\s*\d|postgres\s*\d/.test(text.split("mysql")[0] ?? "")
+  const wantsPostgres = /postgresql\s*\d|postgres\s*\d/.test(text)
+  if (wantsMysql && connection.type === "postgres") {
+    return "环境不符：题目文档按 MySQL 编写，而当前连接是 PostgreSQL。语法与函数并不通用，请确认这是同一个演练环境，或改用 MySQL 连接。"
+  }
+  if (wantsPostgres && connection.type === "mysql") {
+    return "环境不符：题目文档按 PostgreSQL 编写，而当前连接是 MySQL。请确认这是同一个演练环境，或改用 PostgreSQL 连接。"
+  }
+  return null
+}
diff --git a/src/game/sandbox.ts b/src/game/sandbox.ts
new file mode 100644
index 0000000..086b6f8
--- /dev/null
+++ b/src/game/sandbox.ts
@@ -0,0 +1,265 @@
+// 自由沙盘：纯逻辑引擎（建工单 / 改库存 / 改 BOM / 推进工序 / 缺料停线）。
+//
+// 设计约束：
+// - 全部是纯函数，输入旧状态、返回新状态，方便写单测；
+// - 不写任何存档（player_progress），沙盘里的库存与工单只活在当前页面；
+// - 解锁判定只认站内第三章「建模与配置」通关这一条，不擅自放宽。
+
+/** 自由沙盘的解锁章节：第三章「建模与配置」通关后开放 */
+export const SANDBOX_UNLOCK_CHAPTER_ID = 3
+
+export interface SandboxBomLine {
+  /** 原料 id */
+  material: string
+  /** 单台用量 */
+  qty: number
+}
+
+export interface SandboxMaterialDef {
+  id: string
+  name: string
+  unit: string
+  /** 初始库存 */
+  initial: number
+  /** 给使用者看的提示 */
+  note?: string
+}
+
+export interface SandboxProductDef {
+  id: string
+  name: string
+  /** 工序（工作中心 id）顺序 */
+  operations: string[]
+  bom: SandboxBomLine[]
+  note?: string
+}
+
+export interface SandboxWorkCenterDef {
+  id: string
+  name: string
+  /** 单台工时（小时），用于展示负荷 */
+  hoursPerUnit?: number
+}
+
+export interface SandboxContent {
+  moduleId: string
+  title: string
+  subtitle: string
+  intro: string
+  tips: string[]
+  materials: SandboxMaterialDef[]
+  products: SandboxProductDef[]
+  workCenters: SandboxWorkCenterDef[]
+}
+
+export type SandboxOrderStatus = "planned" | "running" | "blocked" | "done"
+export type SandboxStepStatus = "pending" | "done"
+
+export interface SandboxShortage {
+  material: string
+  /** 这一批需要多少 */
+  need: number
+  /** 现在有多少 */
+  have: number
+}
+
+export interface SandboxOrder {
+  id: string
+  productId: string
+  qty: number
+  status: SandboxOrderStatus
+  /** 已经推进到第几道工序（-1 = 还没领料开工） */
+  stepIndex: number
+  steps: { opId: string; status: SandboxStepStatus }[]
+  shortage?: SandboxShortage
+}
+
+export interface SandboxLogEntry {
+  at: string
+  text: string
+  tone: "info" | "good" | "warn" | "danger"
+}
+
+export interface SandboxState {
+  /** 原料库存（允许为负，用来演示负库存） */
+  inventory: Record<string, number>
+  /** 可编辑的 BOM：productId -> 单台用量 */
+  bom: Record<string, SandboxBomLine[]>
+  orders: SandboxOrder[]
+  /** 完工数：productId -> 台数 */
+  finished: Record<string, number>
+  log: SandboxLogEntry[]
+}
+
+function nowStamp(): string {
+  const d = new Date()
+  const p = (n: number) => String(n).padStart(2, "0")
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`
+}
+
+function withLog(state: SandboxState, text: string, tone: SandboxLogEntry["tone"] = "info"): SandboxState {
+  return { ...state, log: [{ at: nowStamp(), text, tone }, ...state.log].slice(0, 60) }
+}
+
+/** 第三章是否已通关 → 自由沙盘是否开放 */
+export function isSandboxUnlocked(chapterStatus: Record<string, string | undefined> | undefined): boolean {
+  if (!chapterStatus) return false
+  return chapterStatus[String(SANDBOX_UNLOCK_CHAPTER_ID)] === "cleared"
+}
+
+/** 锁定时的提示文案：说清楚还差哪一条，不含糊 */
+export function sandboxLockMessage(chapterStatus: Record<string, string | undefined> | undefined): string {
+  const state = chapterStatus?.[String(SANDBOX_UNLOCK_CHAPTER_ID)]
+  if (state === "cleared") return ""
+  if (state === "open") {
+    return `第${SANDBOX_UNLOCK_CHAPTER_ID}章「建模与配置」已经解锁、还没通关：通关之后自由沙盘自动开放。`
+  }
+  return `第${SANDBOX_UNLOCK_CHAPTER_ID}章「建模与配置」还没解锁：先按主线把前面的章节打通，通关第${SANDBOX_UNLOCK_CHAPTER_ID}章之后自由沙盘自动开放。`
+}
+
+export function createSandboxState(content: SandboxContent): SandboxState {
+  const inventory: Record<string, number> = {}
+  for (const m of content.materials) inventory[m.id] = m.initial
+  const bom: Record<string, SandboxBomLine[]> = {}
+  for (const p of content.products) bom[p.id] = p.bom.map((line) => ({ ...line }))
+  const finished: Record<string, number> = {}
+  for (const p of content.products) finished[p.id] = 0
+  return {
+    inventory,
+    bom,
+    orders: [],
+    finished,
+    log: [{ at: nowStamp(), text: "沙盘已就绪：改库存、下工单，推进工序看物料怎么流动。", tone: "info" }],
+  }
+}
+
+/** 直接设定某个原料的库存（允许负数） */
+export function setStock(state: SandboxState, materialId: string, value: number): SandboxState {
+  if (!Number.isFinite(value)) return state
+  const inventory = { ...state.inventory, [materialId]: Math.round(value * 100) / 100 }
+  const next = { ...state, inventory }
+  const mat = materialId
+  return withLog(next, `库存调整：${mat} → ${inventory[materialId]}`, value < 0 ? "warn" : "info")
+}
+
+/** 在现有库存上加减 */
+export function adjustStock(state: SandboxState, materialId: string, delta: number): SandboxState {
+  const current = state.inventory[materialId] ?? 0
+  return setStock(state, materialId, current + delta)
+}
+
+/** 改单台用量（演示「BOM 错了整条线会怎样」） */
+export function setBomQty(state: SandboxState, productId: string, materialId: string, qty: number): SandboxState {
+  if (!Number.isFinite(qty) || qty < 0) return state
+  const lines = state.bom[productId] ?? []
+  const existing = lines.find((l) => l.material === materialId)
+  const nextLines = existing
+    ? lines.map((l) => (l.material === materialId ? { ...l, qty } : l))
+    : [...lines, { material: materialId, qty }]
+  return withLog(
+    { ...state, bom: { ...state.bom, [productId]: nextLines } },
+    `BOM 改动：${productId} 的 ${materialId} 单台用量 → ${qty}`,
+    "warn",
+  )
+}
+
+/** 这一批订单各原料需要多少 */
+export function materialNeeds(state: SandboxState, order: SandboxOrder): Record<string, number> {
+  const lines = state.bom[order.productId] ?? []
+  const needs: Record<string, number> = {}
+  for (const line of lines) {
+    needs[line.material] = (needs[line.material] ?? 0) + line.qty * order.qty
+  }
+  return needs
+}
+
+export function createOrder(state: SandboxState, content: SandboxContent, productId: string, qty: number): SandboxState {
+  const product = content.products.find((p) => p.id === productId)
+  if (!product) return state
+  const count = Math.floor(qty)
+  if (!Number.isFinite(count) || count <= 0) return state
+  const order: SandboxOrder = {
+    id: `WO-${String(state.orders.length + 1).padStart(3, "0")}`,
+    productId,
+    qty: count,
+    status: "planned",
+    stepIndex: -1,
+    steps: product.operations.map((opId) => ({ opId, status: "pending" as SandboxStepStatus })),
+  }
+  return withLog(
+    { ...state, orders: [...state.orders, order] },
+    `新建工单 ${order.id}：${product.name} × ${count}`,
+    "info",
+  )
+}
+
+/**
+ * 推进一道工序。
+ * - 第一道工序领料：按当前 BOM 扣原料；库存不够就停线（blocked），不扣料；
+ * - 之后的工序只推进在制品位置，不额外扣料；
+ * - 最后一道工序做完 → 完工入库。
+ */
+export function advanceOrder(state: SandboxState, content: SandboxContent, orderId: string): SandboxState {
+  const order = state.orders.find((o) => o.id === orderId)
+  if (!order || order.status === "done") return state
+  const product = content.products.find((p) => p.id === order.productId)
+  if (!product) return state
+
+  if (order.stepIndex < 0) {
+    // 领料开工
+    const needs = materialNeeds(state, order)
+    for (const [materialId, need] of Object.entries(needs)) {
+      const have = state.inventory[materialId] ?? 0
+      if (have < need) {
+        const shortage: SandboxShortage = { material: materialId, need, have }
+        const blocked: SandboxOrder = { ...order, status: "blocked", shortage }
+        return withLog(
+          { ...state, orders: state.orders.map((o) => (o.id === orderId ? blocked : o)) },
+          `停线：${order.id} 缺料 ${materialId}（需 ${need}，只有 ${have}）`,
+          "danger",
+        )
+      }
+    }
+    const inventory = { ...state.inventory }
+    for (const [materialId, need] of Object.entries(needs)) {
+      inventory[materialId] = Math.round(((inventory[materialId] ?? 0) - need) * 100) / 100
+    }
+    const steps = order.steps.map((s, i) => (i === 0 ? { ...s, status: "done" as SandboxStepStatus } : s))
+    const running: SandboxOrder = { ...order, status: "running", stepIndex: 0, steps, shortage: undefined }
+    return withLog(
+      { ...state, inventory, orders: state.orders.map((o) => (o.id === orderId ? running : o)) },
+      `${order.id} 领料开工：${product.operations[0]}`,
+      "good",
+    )
+  }
+
+  // 往后推一道工序
+  const nextIndex = order.stepIndex + 1
+  if (nextIndex >= order.steps.length) {
+    const done: SandboxOrder = { ...order, status: "done", shortage: undefined }
+    const finished = { ...state.finished, [order.productId]: (state.finished[order.productId] ?? 0) + order.qty }
+    return withLog(
+      { ...state, finished, orders: state.orders.map((o) => (o.id === orderId ? done : o)) },
+      `${order.id} 完工入库：${product.name} × ${order.qty}`,
+      "good",
+    )
+  }
+  const steps = order.steps.map((s, i) => (i === nextIndex ? { ...s, status: "done" as SandboxStepStatus } : s))
+  const running: SandboxOrder = { ...order, status: "running", stepIndex: nextIndex, steps, shortage: undefined }
+  return withLog(
+    { ...state, orders: state.orders.map((o) => (o.id === orderId ? running : o)) },
+    `${order.id} 推进到 ${product.operations[nextIndex]}`,
+    "info",
+  )
+}
+
+/** 取消一张工单（未完工的才允许取消） */
+export function cancelOrder(state: SandboxState, orderId: string): SandboxState {
+  const order = state.orders.find((o) => o.id === orderId)
+  if (!order || order.status === "done") return state
+  return withLog(
+    { ...state, orders: state.orders.map((o) => (o.id === orderId ? { ...o, status: "planned", stepIndex: -1, steps: o.steps.map((s) => ({ ...s, status: "pending" })) } : o)) },
+    `${order.id} 已撤回，原料不退还（模拟已投料）`,
+    "warn",
+  )
+}
