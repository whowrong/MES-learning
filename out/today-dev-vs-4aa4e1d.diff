+})
+
+const deliverable: DeliveryDeliverableDef = {
+  id: "oper_manual",
+  title: "操作手册",
+  audience: "操作工",
+  purpose: "照着能干活",
+  template: "结构",
+  min_chars: 50,
+  required_elements: [
+    { id: "version", label: "版本号与生效日期", hint: "封面写版本号", patterns: ["版本", "生效"] },
+    { id: "roles", label: "角色与适用范围", hint: "写明谁用", patterns: ["岗位", "角色"] },
+    { id: "shots", label: "截图占位", hint: "留截图位", patterns: ["截图", "占位"] },
