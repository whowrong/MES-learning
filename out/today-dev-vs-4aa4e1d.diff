+// 自由沙盘引擎单测：解锁判据、库存调整、BOM 改动、缺料停线与完工入库。
+import { describe, expect, it } from "vitest"
+import {
+  SANDBOX_UNLOCK_CHAPTER_ID,
+  advanceOrder,
+  adjustStock,
+  cancelOrder,
+  createOrder,
+  createSandboxState,
+  isSandboxUnlocked,
+  materialNeeds,
+  sandboxLockMessage,
+  setBomQty,
+  setStock,
+  type SandboxContent,
+} from "@/game/sandbox"
+import sandboxRaw from "../../../public/content/sandbox/index.json"
+
+const content = sandboxRaw as SandboxContent
+
+describe("自由沙盘解锁判据", () => {
+  it("只认第三章通关这一条", () => {
+    expect(SANDBOX_UNLOCK_CHAPTER_ID).toBe(3)
+    expect(isSandboxUnlocked({ "1": "cleared", "2": "cleared", "3": "cleared" })).toBe(true)
+  })
+
+  it("第三章没通关就不算解锁（其它章节通关也不行）", () => {
+    expect(isSandboxUnlocked({ "1": "cleared", "2": "cleared", "3": "open", "4": "cleared" })).toBe(false)
+    expect(isSandboxUnlocked({})).toBe(false)
+    expect(isSandboxUnlocked(undefined)).toBe(false)
+  })
+
+  it("锁定文案说清楚还差哪一条", () => {
+    expect(sandboxLockMessage({ "3": "cleared" })).toBe("")
+    expect(sandboxLockMessage({ "3": "open" })).toContain("还没通关")
+    expect(sandboxLockMessage({ "3": "locked" })).toContain("还没解锁")
+  })
+})
+
+describe("沙盘状态与库存", () => {
+  it("初始库存按内容文件建档", () => {
+    const state = createSandboxState(content)
+    expect(state.orders).toHaveLength(0)
+    for (const m of content.materials) {
+      expect(state.inventory[m.id]).toBe(m.initial)
+    }
+  })
+
+  it("库存可以改成负数（负库存场景）", () => {
+    const state = setStock(createSandboxState(content), "steel", -5)
+    expect(state.inventory.steel).toBe(-5)
+  })
+
+  it("加减库存是纯函数，不改旧状态", () => {
+    const base = createSandboxState(content)
+    const next = adjustStock(base, "steel", -10)
+    expect(next.inventory.steel).toBe(base.inventory.steel - 10)
+    expect(base.inventory.steel).toBe(content.materials.find((m) => m.id === "steel")!.initial)
+  })
+})
+
+describe("工单与工序推进", () => {
+  it("下单后按产品的工序排好步骤", () => {
+    const state = createOrder(createSandboxState(content), content, "pump", 2)
+    expect(state.orders).toHaveLength(1)
+    const order = state.orders[0]
+    expect(order.qty).toBe(2)
+    expect(order.steps.map((s) => s.opId)).toEqual(["cut", "weld", "assemble"])
+    expect(order.status).toBe("planned")
+  })
+
+  it("数量非法时不建单", () => {
+    const base = createSandboxState(content)
+    expect(createOrder(base, content, "pump", 0).orders).toHaveLength(0)
+    expect(createOrder(base, content, "pump", -3).orders).toHaveLength(0)
+    expect(createOrder(base, content, "not-exist", 1).orders).toHaveLength(0)
+  })
+
+  it("物料需求按单台用量乘批量", () => {
+    const state = createOrder(createSandboxState(content), content, "pump", 3)
+    const needs = materialNeeds(state, state.orders[0])
+    expect(needs.steel).toBe(30)
+    expect(needs.bolt).toBe(18)
+  })
+
+  it("领料会扣库存，工序逐步推进，最后完工入库", () => {
+    let state = createOrder(createSandboxState(content), content, "pump", 1)
+    const id = state.orders[0].id
+    const steelBefore = state.inventory.steel
+
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].status).toBe("running")
+    expect(state.inventory.steel).toBe(steelBefore - 10)
+
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].stepIndex).toBe(1)
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].stepIndex).toBe(2)
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].status).toBe("done")
+    expect(state.finished.pump).toBe(1)
+  })
+
+  it("库存不够就停线：不扣料、补料后能继续", () => {
+    let state = createOrder(createSandboxState(content), content, "heater", 2)
+    const id = state.orders[0].id
+    state = setStock(state, "copper", 1) // 需要 6，只有 1
+
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].status).toBe("blocked")
+    expect(state.orders[0].shortage?.material).toBe("copper")
+    expect(state.orders[0].shortage?.need).toBe(6)
+    expect(state.inventory.copper).toBe(1) // 停线不扣料
+
+    state = setStock(state, "copper", 20)
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].status).toBe("running")
+    expect(state.inventory.copper).toBe(14)
+  })
+
+  it("BOM 改错之后先在领料这步断料", () => {
+    let state = createOrder(createSandboxState(content), content, "pump", 1)
+    const id = state.orders[0].id
+    state = setBomQty(state, "pump", "steel", 500) // 把 BOM 写错
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].status).toBe("blocked")
+    expect(state.orders[0].shortage?.material).toBe("steel")
+  })
+
+  it("撤回的工单回到待开工", () => {
+    let state = createOrder(createSandboxState(content), content, "pump", 1)
+    const id = state.orders[0].id
+    state = advanceOrder(state, content, id)
+    expect(state.orders[0].status).toBe("running")
+    state = cancelOrder(state, id)
+    expect(state.orders[0].status).toBe("planned")
+    expect(state.orders[0].stepIndex).toBe(-1)
+  })
+
+  it("完工的工单不能再推进", () => {
+    let state = createOrder(createSandboxState(content), content, "pump", 1)
+    const id = state.orders[0].id
+    for (let i = 0; i < 4; i += 1) state = advanceOrder(state, content, id)
+    expect(state.orders[0].status).toBe("done")
+    const before = state.finished.pump
+    state = advanceOrder(state, content, id)
+    expect(state.finished.pump).toBe(before)
+  })
+})
diff --git a/src/game/delivery.ts b/src/game/delivery.ts
new file mode 100644
index 0000000..b4f7d82
--- /dev/null
+++ b/src/game/delivery.ts
@@ -0,0 +1,158 @@
+// 上线陪产 · 交付闭环的纯逻辑：组卷判定 + 交付物结构校验。
+//
+// 判分与计分口径直接复用「实习准备营」的纯函数（多选少选都算错、顺序题必须
+// 完全正确才得分），保证站内两个模块的判分标准一致；本文件只新增交付物工作区
+// 的结构校验，这部分是站内独一份的能力：按必备要素逐条查文本，而不是数字数。
+import { shuffle } from "@/content/loader"
+import {
+  judgeCareerQuestion,
+  scoreCareerPaper,
+  wrongCareerTermIds,
+  type CareerPaperScore,
+} from "@/game/careerPrep"
+import type {
+  DeliveryDeliverableDef,
+  DeliveryModule,
+  DeliveryOrder,
+  DeliveryQuestion,
+} from "@/content/delivery"
+
+export interface DeliveryPaper {
+  questions: DeliveryQuestion[]
+  order: DeliveryOrder | null
+}
+
+/** 组卷：抽题（0 = 全部），顺序题随机取一道 */
+export function buildDeliveryPaper(
+  mod: DeliveryModule,
+  questionCount: number,
+  orderCount: number,
+): DeliveryPaper {
+  const all = shuffle(mod.questions)
+  const questions = questionCount > 0 ? all.slice(0, Math.min(questionCount, all.length)) : all
+  const orders = shuffle(mod.orders)
+  const order = orderCount > 0 ? orders[0] ?? null : null
+  return { questions, order }
+}
+
+/** 客观题判定（多选按集合相等，单选/判断按字符串相等） */
+export function judgeDeliveryQuestion(q: DeliveryQuestion, given: string | string[]): boolean {
+  return judgeCareerQuestion(q, given)
+}
+
+/** 计分：客观题与顺序题等权，顺序题必须完全正确 */
+export function scoreDeliveryPaper(
+  paper: DeliveryPaper,
+  answers: Map<string, string | string[]>,
+  orderAnswer: string[] | null,
+): CareerPaperScore {
+  return scoreCareerPaper(paper, answers, orderAnswer)
+}
+
+/** 答错的题关联术语 → 复习队列（去重） */
+export function wrongDeliveryTermIds(score: CareerPaperScore): string[] {
+  return wrongCareerTermIds(score)
+}
+
+/** 单条必备要素的校验结果 */
+export interface DeliveryElementCheck {
+  id: string
+  label: string
+  hint: string
+  /** 文本里命中了至少一条规则 */
+  ok: boolean
+}
+
+/** 一件交付物的结构校验结果 */
+export interface DeliveryCheck {
+  id: string
+  title: string
+  /** 当前字数 */
+  chars: number
+  /** 字数门槛 */
+  minChars: number
+  /** 字数是否够 */
+  enough: boolean
+  elements: DeliveryElementCheck[]
+  /** 命中的要素数 */
+  passed: number
+  /** 要素总数 */
+  total: number
+  /** 齐全度 0~1（只按要素算，字数另计） */
+  ratio: number
+  /** 该交付物是否算写完（字数够且要素齐全） */
+  complete: boolean
+  /** 还缺哪些要素（label 列表） */
+  missing: string[]
+}
+
+function matches(text: string, pattern: string): boolean {
+  try {
+    return new RegExp(pattern, "i").test(text)
+  } catch {
+    return false
+  }
+}
+
+/** 校验一件交付物：字数门槛 + 必备要素逐条命中 */
+export function checkDeliverable(def: DeliveryDeliverableDef, text: string): DeliveryCheck {
+  const body = typeof text === "string" ? text : ""
+  const chars = body.trim().length
+  const minChars = def.min_chars > 0 ? def.min_chars : 1
+  const elements: DeliveryElementCheck[] = def.required_elements.map((el) => ({
+    id: el.id,
+    label: el.label,
+    hint: el.hint,
+    ok: el.patterns.some((p) => matches(body, p)),
+  }))
+  const passed = elements.filter((e) => e.ok).length
+  const total = elements.length
+  const enough = chars >= minChars
+  return {
+    id: def.id,
+    title: def.title,
+    chars,
+    minChars,
+    enough,
+    elements,
+    passed,
+    total,
+    ratio: total > 0 ? passed / total : 0,
+    complete: enough && passed === total,
+    missing: elements.filter((e) => !e.ok).map((e) => e.label),
+  }
+}
+
+export interface DeliveryWorkspaceCheck {
+  checks: DeliveryCheck[]
+  /** 写完的交付物数量 */
+  completeCount: number
+  /** 四件交付物整体齐全度 0~1 */
+  ratio: number
+  /** 四件全部写完 */
+  allComplete: boolean
+}
+
+/** 校验整个交付物工作区 */
+export function checkWorkspace(
+  defs: DeliveryDeliverableDef[],
+  drafts: Record<string, string>,
+): DeliveryWorkspaceCheck {
+  const checks = defs.map((d) => checkDeliverable(d, drafts[d.id] ?? ""))
+  const completeCount = checks.filter((c) => c.complete).length
+  const sum = checks.reduce((s, c) => s + c.ratio, 0)
+  return {
+    checks,
+    completeCount,
+    ratio: checks.length > 0 ? sum / checks.length : 0,
+    allComplete: checks.length > 0 && completeCount === checks.length,
+  }
+}
+
+/** 评级与其它模块同一套档位：S≥95 / A≥85 / B≥70 / 其余 C */
+export function deliveryRank(score: number): "S" | "A" | "B" | "C" {
+  if (score >= 95) return "S"
+  if (score >= 85) return "A"
+  if (score >= 70) return "B"
+  return "C"
+}
