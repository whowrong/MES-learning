+{
+  "moduleId": "delivery",
+  "moduleName": "上线陪产 · 交付闭环",
+  "subtitle": "四件交付物怎么写、割接窗口怎么守、上线后第一个月怎么陪",
+  "intro": "前几章练的是怎么把系统配出来、把数据洗干净。这一章练的是怎么把它交出去：操作手册、需求调研记录、上线验收单、培训课件这四件交付物分别怎么写、写完交给谁；实施九步每一步该交出什么、谁产出、什么时候交；割接窗口怎么守、数据怎么退、真出事了谁拍板回滚。你会反复面对车间主任、甲方项目经理和老板的三种提问，练习把一句车间口语变成一条能签字、能验收、能追责的条目。",
+  "knowledge_ids": [
+    "K9-7",
+    "K9-8",
+    "K9-9",
+    "K9-10",
+    "K9-11",
+    "K9-12",
+    "K10-11",
+    "K10-12"
+  ],
+  "cards": [
+    {
+      "id": "d-oper-manual",
+      "title": "操作手册怎么写才有人用",
+      "summary": "读者是站在工位上扫码的操作工，不是你，写法要按岗位拆到一步一图。",
+      "points": [
+        "按岗位分册：报工员、班组长、仓管各一本，别做一本大全",
+        "一步一图：图上标红按钮位置，文字只写动作不写界面",
+        "每个动作后写一句「看到什么算成功」，如「屏幕显示已保存」",
+        "单独一章写报错处理：扫不出工单、重复报工、数量录错怎么改",
+        "页脚标版本号与生效日期，旧版当场回收，别两版一起挂工位",
+        "让一个没参与项目的人照着做完一件事，做不到就是没写完"
+      ],
+      "pitfalls": [
+        "把系统帮助文档抄一遍，操作工看不懂那些术语",
+        "只写正常流程，师傅遇到报错就绕开系统",
+        "手册改版不通知现场，车间用着早已作废的版本"
+      ],
+      "knowledge_ids": [
+        "K9-11"
+      ],
+      "term_ids": [
+        "oper_manual",
+        "barcode_report",
+        "reporting",
+        "shift"
+      ]
+    },
+    {
+      "id": "d-requirement-survey",
+      "title": "需求调研记录怎么写",
+      "summary": "把车间口语原样留住，再按影响面和紧急度分成必须做、后置做、不做三档。",
+      "points": [
+        "记原话：师傅说「扫码要按两下」就写两下，别急着替他翻译",
+        "每条记录写五栏：调研对象、日期、痛点、确认结论、待决事项",
+        "按需求分级：上线前必须做、上线后再做、明确不做",
+        "待决事项挂到人和期限，超过一周没结论就升到周会",
+        "结论要对方签字或回邮件确认，口头说过的不算数",
+        "原始说法留档，后面谈需求变更全靠这一份底稿"
+      ],
+      "pitfalls": [
+        "把车间方言直接写成功能点，开发照做出来没人用",
+        "分级只写「以后再说」，上线范围还是没边界"
+      ],
+      "knowledge_ids": [
+        "K9-10",
+        "K10-11"
+      ],
+      "term_ids": [
+        "requirement_survey",
+        "requirement_tier",
+        "onsite_comm",
+        "data_owner"
+      ]
+    },
+    {
+      "id": "d-acceptance",
+      "title": "上线验收单怎么写",
+      "summary": "验收项要能被复现，遗留问题要挂账，签字才不背锅。",
+      "points": [
+        "验收项逐条对合同与蓝图，一条一项，编号能追溯到条款",
+        "每条写验证方式与实测结果：谁验的、抽了几笔、结论是什么",
+        "遗留问题单独立表：现象、影响、责任方、期限、复验人",
+        "遗留问题不阻断签字，但要有到期日和双方确认的关闭方式",
+        "数据类验收写清口径和样本量：抽 3 个班组各 20 笔报工核对",
+        "双方签字加日期，一式两份，实施方与甲方各留一份"
+      ],
+      "pitfalls": [
+        "验收项写成「系统功能正常」，客户怎么验全凭心情",
+        "遗留问题写成「以后优化」，没有期限也没有责任人"
+      ],
+      "knowledge_ids": [
+        "K9-9"
+      ],
+      "term_ids": [
+        "acceptance",
+        "blueprint",
+        "no_problem",
+        "go_live"
+      ]
+    },
+    {
+      "id": "d-training-ppt",
+      "title": "培训课件大纲怎么搭",
+      "summary": "按岗位分组讲、演练完当场考核，上线一周后再抽查一次。",
+      "points": [
+        "按岗位分组讲：每个人只学自己要用的那部分功能",
+        "每节课件控制在 30 分钟一单元，后面紧跟一次现场演练",
+        "用真实数据当教具：拿昨天那张工单讲，别用演示假单",
+        "考核当场做：每人独立完成一次报工，错一个记不合格",
+        "培训记录要留全：签到表、考核卷、补训名单",
+        "上线后第 7 天再抽查一次，合格率低于 90% 就安排补训"
+      ],
+      "pitfalls": [
+        "照着界面截屏讲参数，讲完没人记得怎么操作",
+        "培训在会议室做，车间第一次上手全靠打电话问顾问"
+      ],
+      "knowledge_ids": [
+        "K9-12"
+      ],
